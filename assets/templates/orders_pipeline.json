  {
   "id": "@items",
   "name": "Order items",
   "icon": "tag",
   "fields": [
    {
     "id": "garment",
     "name": "Garment",
     "type": "calculated",
     "declaredOutputType": "single_select",
     "lookup": {
      "referenceFieldId": "sku",
      "fieldId": "garment"
     }
    },
    {
     "id": "size",
     "name": "Size",
     "type": "calculated",
     "declaredOutputType": "single_select",
     "lookup": {
      "referenceFieldId": "sku",
      "fieldId": "size"
     }
    },
    {
     "id": "colour",
     "name": "Colour",
     "type": "calculated",
     "declaredOutputType": "single_select",
     "lookup": {
      "referenceFieldId": "sku",
      "fieldId": "colour"
     }
    },
    {
     "id": "sku",
     "name": "Item from stock",
     "type": "reference",
     "targetCollectionId": "@inventory",
     "multiple": false,
     "required": true
    },
    {
     "id": "notes",
     "name": "Embroidery & notes",
     "type": "text",
     "multiline": true
    },
    {
     "id": "qty",
     "name": "Quantity",
     "type": "number",
     "min": 1
    },
    {
     "id": "done",
     "name": "Done",
     "type": "boolean"
    },
    {
     "id": "order",
     "name": "Order",
     "type": "reference",
     "targetCollectionId": "@orders",
     "multiple": false,
     "required": true
    },
    {
     "id": "orderStatus",
     "name": "Order status",
     "type": "calculated",
     "declaredOutputType": "single_select",
     "lookup": {
      "referenceFieldId": "order",
      "fieldId": "status"
     }
    }
   ],
   "views": [
    {
     "id": "all",
     "name": "All items",
     "mode": "table",
     "fieldIds": [
      "garment",
      "size",
      "colour",
      "notes",
      "qty",
      "done",
      "order",
      "orderStatus"
     ],
     "filters": [],
     "manualOrder": []
    },
    {
     "id": "todo",
     "name": "To make",
     "mode": "table",
     "fieldIds": [
      "garment",
      "size",
      "colour",
      "notes",
      "qty",
      "order",
      "orderStatus"
     ],
     "filters": [
      {
       "fieldId": "done",
       "op": "isFalse"
      }
     ],
     "manualOrder": []
    }
   ],
   "layout": {
    "sections": [
     {
      "id": "s0",
      "title": null,
      "collapsed": false,
      "rows": [
       {
        "id": "s0r0",
        "cells": [
         {
          "fieldId": "sku",
          "span": 12
         }
        ]
       },
       {
        "id": "s0r1",
        "cells": [
         {
          "fieldId": "garment",
          "span": 4
         },
         {
          "fieldId": "size",
          "span": 4
         },
         {
          "fieldId": "colour",
          "span": 4
         }
