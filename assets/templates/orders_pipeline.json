      "source": "linkedFrom",
      "collectionId": "@items",
      "referenceFieldId": "sku",
      "op": "sum",
      "fieldId": "qty",
      "filters": [
       {
        "fieldId": "orderStatus",
        "op": "anyOf",
        "operand": [
         "ordered",
         "clarify",
         "queue",
         "progress",
         "made"
        ]
       }
      ]
     }
    },
    {
     "id": "sold",
     "name": "Sold",
     "type": "calculated",
     "declaredOutputType": "number",
     "aggregate": {
      "source": "linkedFrom",
      "collectionId": "@items",
      "referenceFieldId": "sku",
      "op": "sum",
      "fieldId": "qty",
      "filters": [
       {
        "fieldId": "orderStatus",
        "op": "anyOf",
        "operand": [
         "shipped",
         "received",
         "notpicked"
        ]
       }
      ]
     }
    },
    {
     "id": "available",
     "name": "Available",
     "type": "calculated",
     "declaredOutputType": "number",
     "expression": "{received} - {reserved} - {sold}"
    }
