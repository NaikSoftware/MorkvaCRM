{
 "id": "orders_pipeline",
 "name": "Orders pipeline",
 "description": "Orders on a status board, their items with a done checkbox, stock that reserves itself.",
 "icon": "cart",
 "collections": [
  {
   "id": "@orders",
   "name": "Orders",
   "icon": "cart",
   "fields": [
    {
     "id": "customer",
     "name": "Customer",
     "type": "text",
     "required": true
    },
    {
     "id": "no",
     "name": "Order #",
     "type": "auto_number",
     "prefix": "ORD-",
     "padding": 4
    },
    {
     "id": "status",
     "name": "Status",
     "type": "single_select",
     "options": [
      {
       "id": "ordered",
       "label": "Ordered",
       "color": "#3A7BD5"
      },
      {
       "id": "clarify",
       "label": "To clarify",
       "color": "#C9A227"
      },
      {
       "id": "queue",
       "label": "In queue",
       "color": "#7E57C2"
      },
      {
       "id": "progress",
       "label": "In progress",
       "color": "#E8821E"
      },
      {
       "id": "made",
       "label": "Made",
       "color": "#26A69A"
      },
      {
       "id": "shipped",
       "label": "Shipped",
       "color": "#43A047"
      },
      {
       "id": "received",
       "label": "Received",
       "color": "#2E7D32"
      },
      {
       "id": "notpicked",
       "label": "Not picked up",
       "color": "#E53935"
      }
     ]
    },
    {
     "id": "deadline",
     "name": "Deadline",
     "type": "date"
    },
    {
     "id": "labels",
     "name": "Labels",
     "type": "multi_select",
     "options": [
      {
       "id": "gift",
       "label": "Gift",
       "color": "#D81B60"
      },
      {
       "id": "design",
       "label": "Needs design",
       "color": "#7E57C2"
      },
      {
       "id": "cod",
       "label": "Cash on delivery",
       "color": "#E8821E"
      },
      {
       "id": "prepaid",
       "label": "Prepaid",
       "color": "#43A047"
      },
      {
       "id": "noturgent",
       "label": "Not urgent",
       "color": "#78909C"
      },
      {
       "id": "hasdeadline",
       "label": "Has deadline",
       "color": "#E53935"
      }
     ]
    },
    {
     "id": "recipient",
     "name": "Recipient",
     "type": "text"
    },
    {
     "id": "phone",
     "name": "Phone",
     "type": "text"
    },
    {
     "id": "city",
     "name": "City",
     "type": "text"
    },
    {
     "id": "point",
     "name": "Shipping point",
     "type": "text"
    },
    {
     "id": "prepayment",
     "name": "Prepayment",
     "type": "number",
     "unitLabel": "₴"
    },
    {
     "id": "cod",
     "name": "Cash on delivery",
     "type": "number",
     "unitLabel": "₴"
    },
    {
     "id": "design",
     "name": "Design images",
     "type": "file",
     "multiple": true
    },
    {
     "id": "itemCount",
     "name": "Items",
     "type": "calculated",
     "declaredOutputType": "number",
     "aggregate": {
      "source": "linkedFrom",
      "collectionId": "@items",
      "referenceFieldId": "order",
      "op": "sum",
      "fieldId": "qty"
     }
    },
    {
     "id": "itemsDone",
     "name": "Items done",
     "type": "calculated",
     "declaredOutputType": "number",
     "aggregate": {
      "source": "linkedFrom",
      "collectionId": "@items",
      "referenceFieldId": "order",
      "op": "sum",
      "fieldId": "qty",
      "filters": [
       {
        "fieldId": "done",
        "op": "isTrue"
       }
      ]
     }
    }
   ],
   "views": [
    {
     "id": "pipeline",
     "name": "Pipeline",
     "mode": "board",
     "layoutFieldId": "status",
     "fieldIds": [
      "customer",
      "no",
      "deadline",
      "labels"
     ],
     "filters": [],
     "manualOrder": []
    },
    {
     "id": "all",
     "name": "All orders",
     "mode": "table",
     "fieldIds": [
      "customer",
      "no",
      "status",
      "deadline",
      "city",
      "prepayment",
      "cod",
      "itemCount"
     ],
     "filters": [],
     "sort": {
      "fieldId": "no",
      "ascending": false
     },
     "manualOrder": []
    }
   ],
   "layout": {
    "sections": [
     {
      "id": "s0",
      "title": null,
      "collapsed": false,
      "rows": [
       {
        "id": "s0r0",
        "cells": [
         {
          "fieldId": "customer",
          "span": 6
         },
         {
          "fieldId": "status",
          "span": 6
         }
        ]
       },
       {
        "id": "s0r1",
        "cells": [
         {
          "fieldId": "no",
          "span": 6
         },
         {
          "fieldId": "deadline",
          "span": 6
         }
        ]
       },
       {
        "id": "s0r2",
        "cells": [
         {
          "fieldId": "labels",
          "span": 12
         }
        ]
       },
       {
        "id": "s0r3",
        "cells": [
         {
          "fieldId": "itemCount",
          "span": 6
         },
         {
          "fieldId": "itemsDone",
          "span": 6
         }
        ]
       }
      ]
     },
     {
      "id": "s1",
      "title": "Delivery & payment",
      "collapsed": true,
      "rows": [
       {
        "id": "s1r0",
        "cells": [
         {
          "fieldId": "recipient",
          "span": 6
         },
         {
          "fieldId": "phone",
          "span": 6
         }
        ]
       },
       {
        "id": "s1r1",
        "cells": [
         {
          "fieldId": "city",
          "span": 6
         },
         {
          "fieldId": "point",
          "span": 6
