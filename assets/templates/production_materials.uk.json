{
 "id": "production_materials",
 "name": "Виробництво й матеріали",
 "description": "Закупівлі тканини й партії пошиву за кольорами, залишки та реальна собівартість одного виробу.",
 "icon": "build",
 "collections": [
  {
   "id": "@colours",
   "name": "Кольори",
   "icon": "tag",
   "fields": [
    {
     "id": "name",
     "name": "Колір",
     "type": "text",
     "required": true
    },
    {
     "id": "fabricPerPiece",
     "name": "Тканини на виріб",
     "type": "number",
     "unitLabel": "кг",
     "decimalPlaces": 2,
     "description": "Скільки основної тканини йде на один виріб. Якщо залишити поле порожнім, залишки теж будуть порожні, а не здаватимуться повними."
    },
    {
     "id": "ribPerPiece",
     "name": "Рибани на виріб",
     "type": "number",
     "unitLabel": "кг",
     "decimalPlaces": 2
    },
    {
     "id": "made",
     "name": "Пошито виробів",
     "type": "calculated",
     "declaredOutputType": "number",
     "aggregate": {
      "source": "linkedFrom",
      "collectionId": "@batches",
      "referenceFieldId": "colour",
      "op": "sum",
      "fieldId": "qty"
     }
    },
    {
     "id": "spent",
     "name": "Витрачено на матеріали",
     "type": "calculated",
     "declaredOutputType": "number",
     "unitLabel": "₴",
     "aggregate": {
      "source": "linkedFrom",
      "collectionId": "@purchases",
      "referenceFieldId": "colour",
      "op": "sum",
      "fieldId": "cost"
     }
    },
    {
     "id": "costPerPiece",
     "name": "Матеріали на виріб",
     "type": "calculated",
     "declaredOutputType": "number",
     "unitLabel": "₴",
     "decimalPlaces": 2,
     "expression": "ROUND({spent} / {made}, 2)"
    },
    {
     "id": "fabricBought",
     "name": "Куплено тканини",
     "type": "calculated",
     "declaredOutputType": "number",
     "unitLabel": "кг",
     "decimalPlaces": 2,
     "aggregate": {
      "source": "linkedFrom",
      "collectionId": "@purchases",
      "referenceFieldId": "colour",
      "op": "sum",
      "fieldId": "kg",
      "filters": [
       {
        "fieldId": "material",
        "op": "anyOf",
        "operand": [
         "fabric"
        ]
       }
      ]
     }
    },
    {
     "id": "fabricOff",
     "name": "Списано тканини",
     "type": "calculated",
     "declaredOutputType": "number",
     "unitLabel": "кг",
     "decimalPlaces": 2,
     "aggregate": {
      "source": "linkedFrom",
      "collectionId": "@purchases",
      "referenceFieldId": "colour",
      "op": "sum",
      "fieldId": "writeOff",
      "filters": [
       {
        "fieldId": "material",
        "op": "anyOf",
        "operand": [
         "fabric"
        ]
       }
      ]
     }
    },
    {
     "id": "fabricLeft",
     "name": "Залишок тканини",
     "type": "calculated",
     "declaredOutputType": "number",
     "unitLabel": "кг",
     "decimalPlaces": 2,
     "expression": "{fabricBought} - {fabricOff} - {made} * {fabricPerPiece} + 0 / {fabricPerPiece}"
    },
    {
     "id": "piecesLeft",
     "name": "Виробів із залишку тканини",
     "type": "calculated",
     "declaredOutputType": "number",
     "expression": "FLOOR({fabricLeft} / {fabricPerPiece})"
    },
    {
     "id": "ribBought",
     "name": "Куплено рибани",
     "type": "calculated",
     "declaredOutputType": "number",
     "unitLabel": "кг",
     "decimalPlaces": 2,
     "aggregate": {
      "source": "linkedFrom",
      "collectionId": "@purchases",
      "referenceFieldId": "colour",
      "op": "sum",
      "fieldId": "kg",
      "filters": [
       {
        "fieldId": "material",
        "op": "anyOf",
        "operand": [
         "rib"
        ]
       }
      ]
     }
    },
    {
     "id": "ribLeft",
     "name": "Залишок рибани",
     "type": "calculated",
     "declaredOutputType": "number",
     "unitLabel": "кг",
     "decimalPlaces": 2,
     "expression": "{ribBought} - {made} * {ribPerPiece} + 0 / {ribPerPiece}"
    }
   ],
   "views": [
    {
     "id": "summary",
     "name": "За кольорами",
     "mode": "summary",
     "fieldIds": [
      "name",
      "made",
      "spent",
      "costPerPiece",
      "fabricLeft",
      "piecesLeft",
      "ribLeft"
     ],
     "filters": [],
     "manualOrder": []
    },
    {
     "id": "table",
     "name": "Таблиця",
     "mode": "table",
     "fieldIds": [
      "name",
      "fabricPerPiece",
      "ribPerPiece",
      "made",
      "spent",
      "costPerPiece",
      "fabricBought",
      "fabricLeft",
      "piecesLeft",
      "ribBought",
      "ribLeft"
     ],
     "filters": [],
     "manualOrder": []
    }
   ]
  },
  {
   "id": "@purchases",
   "name": "Закупівлі матеріалів",
   "icon": "receipt",
   "fields": [
    {
     "id": "date",
     "name": "Дата",
     "type": "date"
    },
    {
     "id": "colour",
     "name": "Колір",
     "type": "reference",
     "targetCollectionId": "@colours",
     "multiple": false,
     "required": true
    },
    {
     "id": "material",
     "name": "Матеріал",
     "type": "single_select",
     "options": [
      {
       "id": "fabric",
       "label": "Основна тканина",
       "color": "#3A7BD5"
      },
      {
       "id": "rib",
       "label": "Рибана",
       "color": "#C9A227"
      }
     ]
    },
    {
     "id": "kg",
     "name": "Куплено",
     "type": "number",
     "unitLabel": "кг",
     "decimalPlaces": 2
    },
    {
     "id": "cost",
     "name": "Вартість",
     "type": "number",
     "unitLabel": "₴"
    },
    {
     "id": "writeOff",
     "name": "Списано",
     "type": "number",
     "unitLabel": "кг",
     "decimalPlaces": 2
    }
   ],
   "views": [
