   ]
  },
  {
   "id": "@summary",
   "name": "Собівартість",
   "icon": "money",
   "fields": [
    {
     "id": "name",
     "name": "Період",
     "type": "text"
    },
    {
     "id": "spent",
     "name": "Витрачено на матеріали",
     "type": "calculated",
     "declaredOutputType": "number",
     "unitLabel": "₴",
     "aggregate": {
      "source": "all",
      "collectionId": "@purchases",
      "op": "sum",
      "fieldId": "cost"
     }
    },
    {
     "id": "made",
     "name": "Пошито виробів",
     "type": "calculated",
     "declaredOutputType": "number",
     "aggregate": {
      "source": "all",
      "collectionId": "@batches",
      "op": "sum",
      "fieldId": "qty"
     }
    },
    {
     "id": "materialPerPiece",
     "name": "Матеріали на виріб",
     "type": "calculated",
     "declaredOutputType": "number",
     "unitLabel": "₴",
     "decimalPlaces": 2,
     "expression": "ROUND({spent} / {made}, 2)"
    },
    {
     "id": "sewing",
     "name": "Пошив на виріб",
     "type": "number",
     "unitLabel": "₴"
    },
    {
     "id": "delivery",
     "name": "Доставка на виріб",
     "type": "number",
     "unitLabel": "₴"
    },
    {
     "id": "trueCost",
     "name": "Реальна собівартість виробу",
     "type": "calculated",
     "declaredOutputType": "number",
     "unitLabel": "₴",
     "decimalPlaces": 2,
     "expression": "{materialPerPiece} + {sewing} + {delivery}"
    },
    {
     "id": "price",
     "name": "Цільова ціна",
     "type": "number",
     "unitLabel": "₴"
    },
    {
     "id": "margin",
     "name": "Маржа на виріб",
     "type": "calculated",
     "declaredOutputType": "number",
     "unitLabel": "₴",
     "decimalPlaces": 2,
     "expression": "{price} - {trueCost}"
    }
   ],
   "views": [
    {
     "id": "summary",
     "name": "Підсумок",
     "mode": "summary",
     "fieldIds": [
      "name",
      "trueCost",
      "margin",
      "materialPerPiece",
      "spent",
      "made",
      "sewing",
      "delivery",
      "price"
     ],
     "filters": [],
     "manualOrder": []
    }
   ]
  }
 ],
