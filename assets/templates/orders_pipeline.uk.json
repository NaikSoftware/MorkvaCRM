    {
     "id": "order",
     "name": "Замовлення",
     "type": "reference",
     "targetCollectionId": "@orders",
     "multiple": false,
     "required": true
    },
    {
     "id": "orderStatus",
     "name": "Статус замовлення",
     "type": "calculated",
     "declaredOutputType": "single_select",
     "lookup": {
      "referenceFieldId": "order",
      "fieldId": "status"
