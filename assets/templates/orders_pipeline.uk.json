{
 "id": "orders_pipeline",
 "name": "Воронка замовлень",
 "description": "Замовлення на дошці статусів, їхні позиції з позначкою виконання й залишки на складі, що резервуються самі.",
 "icon": "cart",
 "collections": [
  {
   "id": "@orders",
   "name": "Замовлення",
   "icon": "cart",
   "fields": [
    {
     "id": "customer",
     "name": "Клієнт",
     "type": "text",
     "required": true
    },
    {
     "id": "no",
     "name": "№ замовлення",
     "type": "auto_number",
     "prefix": "ORD-",
     "padding": 4
    },
    {
     "id": "status",
     "name": "Статус",
     "type": "single_select",
     "options": [
      {
       "id": "ordered",
       "label": "Замовлено",
       "color": "#3A7BD5"
      },
      {
       "id": "clarify",
       "label": "Уточнити",
       "color": "#C9A227"
      },
      {
       "id": "queue",
       "label": "У черзі",
       "color": "#7E57C2"
      },
      {
       "id": "progress",
       "label": "У роботі",
       "color": "#E8821E"
      },
      {
       "id": "made",
       "label": "Виготовлено",
       "color": "#26A69A"
      },
      {
       "id": "shipped",
       "label": "Відправлено",
       "color": "#43A047"
      },
      {
       "id": "received",
       "label": "Отримано",
       "color": "#2E7D32"
      },
      {
       "id": "notpicked",
       "label": "Не забрали",
       "color": "#E53935"
      }
     ]
    },
    {
     "id": "deadline",
     "name": "Термін",
     "type": "date"
    },
    {
     "id": "labels",
     "name": "Мітки",
     "type": "multi_select",
     "options": [
      {
       "id": "gift",
       "label": "Подарунок",
       "color": "#D81B60"
      },
      {
       "id": "design",
       "label": "Потрібен дизайн",
       "color": "#7E57C2"
      },
      {
       "id": "cod",
       "label": "Накладений платіж",
       "color": "#E8821E"
      },
      {
       "id": "prepaid",
       "label": "Передплачено",
       "color": "#43A047"
      },
      {
       "id": "noturgent",
       "label": "Не терміново",
       "color": "#78909C"
      },
      {
       "id": "hasdeadline",
       "label": "Є термін",
       "color": "#E53935"
      }
     ]
    },
    {
     "id": "recipient",
     "name": "Отримувач",
     "type": "text"
    },
    {
     "id": "phone",
     "name": "Телефон",
     "type": "text"
    },
    {
     "id": "city",
     "name": "Місто",
     "type": "text"
    },
    {
     "id": "point",
     "name": "Відділення доставки",
     "type": "text"
    },
    {
     "id": "prepayment",
     "name": "Передоплата",
     "type": "number",
     "unitLabel": "₴"
    },
    {
     "id": "cod",
     "name": "Накладений платіж",
     "type": "number",
     "unitLabel": "₴"
    },
    {
     "id": "design",
     "name": "Макети дизайну",
     "type": "file",
     "multiple": true
    },
    {
     "id": "itemCount",
     "name": "Позиції",
     "type": "calculated",
     "declaredOutputType": "number",
     "aggregate": {
      "source": "linkedFrom",
      "collectionId": "@items",
      "referenceFieldId": "order",
      "op": "sum",
      "fieldId": "qty"
     }
    },
    {
     "id": "itemsDone",
     "name": "Виконано позицій",
     "type": "calculated",
     "declaredOutputType": "number",
     "aggregate": {
      "source": "linkedFrom",
      "collectionId": "@items",
      "referenceFieldId": "order",
      "op": "sum",
      "fieldId": "qty",
      "filters": [
       {
        "fieldId": "done",
        "op": "isTrue"
       }
      ]
     }
    }
   ],
   "views": [
    {
     "id": "pipeline",
     "name": "Воронка",
     "mode": "board",
     "layoutFieldId": "status",
     "fieldIds": [
      "customer",
      "no",
      "deadline",
      "labels"
     ],
     "filters": [],
     "manualOrder": []
    },
    {
     "id": "all",
     "name": "Усі замовлення",
     "mode": "table",
     "fieldIds": [
      "customer",
      "no",
      "status",
      "deadline",
      "city",
      "prepayment",
      "cod",
      "itemCount"
     ],
     "filters": [],
     "sort": {
      "fieldId": "no",
      "ascending": false
     },
     "manualOrder": []
    }
   ],
   "layout": {
    "sections": [
     {
      "id": "s0",
      "title": null,
      "collapsed": false,
      "rows": [
